# Общие параметры окружения
ENV=development
# Уровни логирования: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_ECHO=false
# Для локальной разработки можно временно включить автоматическое создание таблиц.
POSTGRES_AUTO_CREATE_SCHEMA=false

# Интеграционные тесты с живым PostgreSQL
# 1 = запускать live-тесты, пусто/0 = пропускать live-тесты
VTELEMAX_RUN_POSTGRES_LIVE_TESTS=0
# Необязательный явный DSN для live-тестов:
# VTELEMAX_TEST_POSTGRES_DSN=postgresql+psycopg://postgres:1234@localhost:5433/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# iiko
IIKO_API_KEY=
IIKO_ORG_ID=
IIKO_BASE_URL=https://api-ru.iiko.services/api/1

# Telegram-адаптер
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# VK-адаптер
VK_BOT_TOKEN=
VK_GROUP_ID=0
# Проверка телефона через VK Mini App: опционально, по умолчанию безопасно выключено.
VK_PHONE_VERIFICATION_MINIAPP_ENABLED=false
# URL страницы VK Mini App, которая открывается из кнопки бота.
VK_PHONE_VERIFICATION_MINIAPP_URL=
# URL API проверки статуса, который опрашивает vk-bot. Рекомендуемый внутренний Docker URL:
# http://vk-phone-verification-service:8085/api/v1/vk/miniapp/session/status
VK_PHONE_VERIFICATION_STATUS_URL=
# Необязательный Bearer-токен для внешнего status API.
VK_PHONE_VERIFICATION_API_TOKEN=
# HTTP timeout для опроса статуса, в секундах.
VK_PHONE_VERIFICATION_TIMEOUT_SECONDS=5
# HMAC-секрет для персональных подписанных ссылок Mini App. В production обязателен.
VK_PHONE_VERIFICATION_LINK_SECRET=
# Время жизни подписанной ссылки, в секундах.
VK_PHONE_VERIFICATION_LINK_TTL_SECONDS=900

# Backend-сервис VK Mini App в отдельном контейнере
VK_PHONE_VERIFICATION_SERVICE_ENABLED=false
VK_PHONE_VERIFICATION_SERVICE_HOST=0.0.0.0
VK_PHONE_VERIFICATION_SERVICE_PORT=8085
VK_PHONE_VERIFICATION_SESSION_TTL_SECONDS=900

# Reverse proxy nginx для публичных endpoint'ов VK Mini App
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
TLS_DOMAIN=sobalbot.24vds.ru
TLS_EMAIL=admin@sobalbot.24vds.ru
# Как часто nginx проверяет изменения сертификатов и перезагружает конфиг, в секундах.
NGINX_CONFIG_CHECK_INTERVAL_SECONDS=300

# Интеграционный API SAGUR: snapshot/delta и прием событий купонов
SAGUR_INTEGRATION_API_ENABLED=false
SAGUR_INTEGRATION_SERVICE_HOST=0.0.0.0
SAGUR_INTEGRATION_SERVICE_PORT=8086
SAGUR_INTEGRATION_DEFAULT_LIMIT=1000
SAGUR_INTEGRATION_MAX_LIMIT=5000
SAGUR_INTEGRATION_RATE_LIMIT_RPM=60
SAGUR_INTEGRATION_HMAC_SECRET=
SAGUR_INTEGRATION_HMAC_MAX_SKEW_SECONDS=60
# Список IP/CIDR через запятую. Пример: 31.148.148.177/32,10.0.0.0/24
SAGUR_INTEGRATION_IP_ALLOWLIST=
# Выбор VK-аккаунтов при экспорте получателей в SAGUR:
# false = экспортировать только активные аккаунты (строгий режим).
# true  = временно разрешить fallback на pending_verification для VK на переходном этапе.
SAGUR_INCLUDE_VK_PENDING_VERIFICATION=false

# Исходящее событие регистрации гостя vtelemax -> SAGUR
# Включает постановку guest_registered в локальный регистр и отправку через отдельный worker.
SAGUR_REGISTRATION_EVENTS_ENABLED=false
# Endpoint приема регистрации на стороне SAGUR / Program-Loyal.
SAGUR_REGISTRATION_EVENTS_ENDPOINT=https://sagur.24vds.ru/internal/integration/v1/vtelemax/registration-events
# HMAC-секрет именно для исходящего события регистрации vtelemax -> SAGUR.
# SAGUR_INTEGRATION_HMAC_SECRET сюда не относится: он используется для входящего SAGUR API.
VTELEMAX_REGISTRATION_CALLBACK_HMAC_SECRET=
# HTTP timeout отправки события регистрации в SAGUR, в секундах.
SAGUR_REGISTRATION_EVENTS_TIMEOUT_SECONDS=5
# Интервал worker отправки готовых SAGUR-событий, в секундах.
SAGUR_REGISTRATION_EVENTS_INTERVAL_SECONDS=60
# Максимальное количество событий за один цикл отправки.
SAGUR_REGISTRATION_EVENTS_BATCH_LIMIT=20
# Максимальное количество попыток отправки одного события в SAGUR.
SAGUR_REGISTRATION_EVENTS_MAX_ATTEMPTS=8
# Контрольное восстановление записей с неизвестным результатом создания iikoCard.
# Восстановитель делает только поиск гостя в iikoCard и не создает гостя фоном.
SAGUR_REGISTRATION_EVENTS_RECOVERY_ENABLED=true
# Интервал worker восстановления, в секундах.
SAGUR_REGISTRATION_EVENTS_RECOVERY_INTERVAL_SECONDS=300
# Максимальное количество проблемных записей за один цикл восстановления.
SAGUR_REGISTRATION_EVENTS_RECOVERY_BATCH_LIMIT=10
# Максимальное количество контрольных поисков iikoCard по одной записи.
SAGUR_REGISTRATION_EVENTS_RECOVERY_MAX_ATTEMPTS=3
# Первая задержка перед контрольным поиском после неизвестного результата iikoCard, в секундах.
SAGUR_REGISTRATION_EVENTS_RECOVERY_FIRST_DELAY_SECONDS=120
# Через сколько секунд зависшее событие в processing возвращается в повторную отправку.
SAGUR_REGISTRATION_EVENTS_LOCK_TIMEOUT_SECONDS=300

# MAX-адаптер
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
# Строгая проверка contact-вложения MAX по hash из payload.
MAX_CONTACT_STRICT_HASH_ENABLED=false
# Shadow mode логирует несовпадения проверки, но не блокирует onboarding.
MAX_CONTACT_HASH_SHADOW_MODE_ENABLED=true
# Политика доставки ответов поддержки для VK-аккаунтов в статусе pending_verification.
# true  = ответы для VK pending_verification разрешены на текущем переходном этапе до строгой проверки через VK Mini App.
# false = ответы разрешены только для активных аккаунтов.
VK_PENDING_VERIFICATION_DELIVERY_ENABLED=true

# Worker доставки сообщений модерации
# Периодический интервал обработки ожидающих сообщений модерации, в секундах.
MODERATION_DELIVERY_INTERVAL_SECONDS=15
# Максимальное количество сообщений за один цикл обработки.
MODERATION_DELIVERY_BATCH_LIMIT=20

# Worker синхронизации профилей с iiko
PROFILE_SYNC_ENABLED=true
PROFILE_SYNC_INTERVAL_SECONDS=15
PROFILE_SYNC_BATCH_LIMIT=50
PROFILE_SYNC_MAX_ATTEMPTS=5

# Администраторы: JSON-массив или CSV
ADMIN_USER_IDS=
