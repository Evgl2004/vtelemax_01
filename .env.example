# Общие параметры окружения
ENV=development
# Уровни: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_ECHO=false
# Для локальной разработки можно временно включить auto-create таблиц.
POSTGRES_AUTO_CREATE_SCHEMA=false

# Integration tests for live PostgreSQL
# 1 = run live tests, empty/0 = skip live tests
VTELEMAX_RUN_POSTGRES_LIVE_TESTS=0
# Optional explicit DSN for live tests:
# VTELEMAX_TEST_POSTGRES_DSN=postgresql+psycopg://postgres:1234@localhost:5433/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# iiko
IIKO_API_KEY=
IIKO_ORG_ID=
IIKO_BASE_URL=https://api-ru.iiko.services/api/1

# Telegram adapter
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# VK adapter
VK_BOT_TOKEN=
VK_GROUP_ID=0
# VK Mini App phone verification (optional, safe by default = disabled)
VK_PHONE_VERIFICATION_MINIAPP_ENABLED=false
# URL to VK Mini App page opened from bot button (external service/UI)
VK_PHONE_VERIFICATION_MINIAPP_URL=
# Status API URL polled by vk-bot. Recommended internal Docker URL:
# http://vk-phone-verification-service:8085/api/v1/vk/miniapp/session/status
VK_PHONE_VERIFICATION_STATUS_URL=
# Optional Bearer token for external status API
VK_PHONE_VERIFICATION_API_TOKEN=
# HTTP timeout for status polling (seconds)
VK_PHONE_VERIFICATION_TIMEOUT_SECONDS=5
# HMAC secret for per-user signed Mini App links (required in production)
VK_PHONE_VERIFICATION_LINK_SECRET=
# Signed link TTL in seconds
VK_PHONE_VERIFICATION_LINK_TTL_SECONDS=900

# VK Mini App backend service (separate container)
VK_PHONE_VERIFICATION_SERVICE_ENABLED=false
VK_PHONE_VERIFICATION_SERVICE_HOST=0.0.0.0
VK_PHONE_VERIFICATION_SERVICE_PORT=8085
VK_PHONE_VERIFICATION_SESSION_TTL_SECONDS=900

# Reverse proxy (nginx container) for VK Mini App public endpoints
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
TLS_DOMAIN=sobalbot.24vds.ru
TLS_EMAIL=admin@sobalbot.24vds.ru
# How often nginx checks certificate changes and reloads config (seconds)
NGINX_CONFIG_CHECK_INTERVAL_SECONDS=300

# SAGUR integration read-only API (delta/snapshot)
SAGUR_INTEGRATION_API_ENABLED=false
SAGUR_INTEGRATION_SERVICE_HOST=0.0.0.0
SAGUR_INTEGRATION_SERVICE_PORT=8086
SAGUR_INTEGRATION_DEFAULT_LIMIT=1000
SAGUR_INTEGRATION_MAX_LIMIT=5000
SAGUR_INTEGRATION_RATE_LIMIT_RPM=60
SAGUR_INTEGRATION_HMAC_SECRET=
SAGUR_INTEGRATION_HMAC_MAX_SKEW_SECONDS=60
# Comma-separated IP/CIDR list, example: 31.148.148.177/32,10.0.0.0/24
SAGUR_INTEGRATION_IP_ALLOWLIST=
# MAX adapter
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
# Strict verification of MAX contact attachment by payload hash.
MAX_CONTACT_STRICT_HASH_ENABLED=false
# Shadow mode logs verification mismatches without blocking onboarding.
MAX_CONTACT_HASH_SHADOW_MODE_ENABLED=true
# Support routing policy for VK accounts in pending_verification status.
# true  = replies to VK pending_verification are allowed (current transition period before VK Mini App strong verification).
# false = replies are allowed only to active accounts.
VK_PENDING_VERIFICATION_DELIVERY_ENABLED=true

# Moderation delivery worker
# Periodic interval for pending moderation messages processing (seconds).
MODERATION_DELIVERY_INTERVAL_SECONDS=15
# Maximum messages processed per periodic cycle.
MODERATION_DELIVERY_BATCH_LIMIT=20

# Profile sync worker (iiko profile updates queue)
PROFILE_SYNC_ENABLED=true
PROFILE_SYNC_INTERVAL_SECONDS=15
PROFILE_SYNC_BATCH_LIMIT=50
PROFILE_SYNC_MAX_ATTEMPTS=5

# Администраторы (JSON-массив или CSV)
ADMIN_USER_IDS=
