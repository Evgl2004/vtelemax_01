# Общие параметры окружения
ENV=development
# Уровни: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_ECHO=false
# Для локальной разработки можно временно включить auto-create таблиц.
POSTGRES_AUTO_CREATE_SCHEMA=false

# Integration tests for live PostgreSQL
# 1 = run live tests, empty/0 = skip live tests
VTELEMAX_RUN_POSTGRES_LIVE_TESTS=0
# Optional explicit DSN for live tests:
# VTELEMAX_TEST_POSTGRES_DSN=postgresql+psycopg://postgres:1234@localhost:5433/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# iiko
IIKO_API_KEY=
IIKO_ORG_ID=
IIKO_BASE_URL=https://api-ru.iiko.services/api/1

# Telegram adapter
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# VK adapter
VK_BOT_TOKEN=
VK_GROUP_ID=0

# MAX adapter
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=

# Moderation delivery worker
# Periodic interval for pending moderation messages processing (seconds).
MODERATION_DELIVERY_INTERVAL_SECONDS=15
# Maximum messages processed per periodic cycle.
MODERATION_DELIVERY_BATCH_LIMIT=20

# Администраторы (JSON-массив или CSV)
ADMIN_USER_IDS=
